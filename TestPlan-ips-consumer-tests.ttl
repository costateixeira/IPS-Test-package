       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "section:sectionProblems.emptyReason (shown as no information) — Consumer confirms each of these is accepted for \"a document whose required sections carry an emptyReason\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "section:sectionAllergies.emptyReason (shown as no information) — Consumer confirms each of these is accepted for \"a document whose required sections carry an emptyReason\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "section:sectionMedications.emptyReason (shown as no information) — Consumer confirms each of these is accepted for \"a document whose required sections carry an emptyReason\"" ]
       ] [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "the document (imported without error) — Consumer confirms each of these is accepted for \"the minimal document\"" ]
       ] )
     ] )
  ] [
     fhir:name [ fhir:v "A Consumer that is a FHIR server is driven directly" ] ;
     fhir:description [ fhir:v "Rule: A Consumer that is a FHIR server is driven directly — the scenarios grouped under it in the feature file." ] ;
     fhir:input ( [
       fhir:name [ fhir:v "gherkin-script" ] ;
       fhir:file [ fhir:v "ips-consumer.feature" ]
     ] ) ;
     fhir:test ( [
       fhir:name [ fhir:v "ips-consumer-950 The document is accepted over the FHIR API" ] ;
       fhir:operation [ fhir:v "gherkin/Scenario" ] ;
       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "$response.status should be one of \"200, 201\"" ]
       ] )
     ] )
  ] ) . # 

