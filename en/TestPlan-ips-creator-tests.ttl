       fhir:name [ fhir:v "ips-creator-003 Patient (IPS) — the Creator populates name; 10 elements when known" ] ;
       fhir:description [ fhir:v "Covers Patient-uv-ips: Patient.identifier, Patient.name, Patient.name.use, Patient.name.text, Patient.name.family, Patient.name.given, Patient.telecom, Patient.gender, Patient.birthDate, Patient.address, Patient.generalPractitioner." ] ;
