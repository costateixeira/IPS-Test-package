       fhir:assertion ( [
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Instances: Bundle.entry.resource.ofType(Patient) Patient.identifier (SHALL:populate-if-known): $ips at \"Bundle.entry.resource.ofType(Patient).all(identifier.exists())\" should be true" ]
